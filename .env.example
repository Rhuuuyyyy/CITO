# CITO Backend - environment variables template
# Copy this file to '.env' and override values locally. Never commit '.env'.

APP_NAME="CITO Backend"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1

# Replace with a strong random value (>=32 bytes) before any non-local deploy.
SECRET_KEY=change-me-in-environment

CORS_ORIGINS=http://localhost:3000

DATABASE_URL=''
PGP_KEY=''
