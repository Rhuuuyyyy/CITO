# CITO Backend - environment variables template
# Copy this file to '.env' and override values locally. Never commit '.env'.

APP_NAME="CITO Backend"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1

# Segredo de assinatura do JWT (HS256). Use valor longo e aleatório (>=32 bytes).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-environment

# Origem(ns) de onde o FRONT é servido. SEM isto o navegador bloqueia as
# chamadas do front (erro de CORS) — tropeço nº 1 do E2E. Aceita CSV ou JSON.
# Use a origem EXATA (esquema+host+porta), sem barra final. "file://" NÃO serve:
# sirva o front por HTTP (ex.: live-server -> http://127.0.0.1:5500).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Banco: precisa do driver ASSÍNCRONO (note o "+asyncpg").
# Formato: postgresql+asyncpg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL='postgresql+asyncpg://postgres:senha@localhost:5432/cito'

# Chave PGP injetada por sessão (SET app.pgp_key) usada pelas triggers das views
# para cifrar/decifrar. DEVE ser a MESMA usada para cifrar os dados existentes.
PGP_KEY='troque-esta-chave-pgp'
